FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 40 0);

boundaryField
{
    front
    {
        type            fixedValue;
        value           nonuniform List<vector> 0();
    }
    back
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
    bottom
    {
        type            noSlip;
    }
    right
    {
        type            zeroGradient;
    }
    left
    {
        type            zeroGradient;
    }
    human
    {
        type            noSlip;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform (0 40 0);
    }
}


